# Server-side only — used by /api/github. NOT exposed to the browser.
# Do NOT prefix with VITE_ (that would embed it in the public bundle).
GITHUB_TOKEN=your_token_here

# Server-side only — used by /api/spotify. Get the first two from the app at
# developer.spotify.com/dashboard, then run `npm run spotify-auth` for the third.
# The app needs http://127.0.0.1:4321/callback as a redirect URI.
SPOTIFY_CLIENT_ID=your_client_id
SPOTIFY_CLIENT_SECRET=your_client_secret
SPOTIFY_REFRESH_TOKEN=run_npm_run_spotify_auth
